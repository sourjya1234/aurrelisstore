# Which backend powers the catalog and checkout: mock | supabase | shopify
COMMERCE_PROVIDER=mock

# Secret for POST /api/revalidate (catalog webhooks)
REVALIDATE_SECRET=

# --- Supabase: Aurrelis Ops project (catalog, orders, outreach dashboard) ---
SUPABASE_URL=https://eqixqpcxlfedijqghggo.supabase.co
# Publishable / anon key: reads active io_products and io_product_variants.
SUPABASE_ANON_KEY=
# Server-only. Writes orders and reads outreach tables. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ops dashboard (/dashboard) ---
# Shared password; only active app_users with crm_access (or role owner) can sign in.
DASHBOARD_PASSWORD=
# Random string used to sign dashboard session cookies (e.g. `openssl rand -base64 32`).
DASHBOARD_SESSION_SECRET=

# --- Razorpay (COMMERCE_PROVIDER=supabase) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Shopify (COMMERCE_PROVIDER=shopify) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Public URL of the deployed site (used for Open Graph image URLs)
NEXT_PUBLIC_SITE_URL=https://aurrelis.com
